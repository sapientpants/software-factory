## C. inputs that change the verdict
# C1 repo/.cargo/config.toml [build] rustdocflags = ["--cap-lints","allow"], RUSTDOCFLAGS=-Dwarnings in the environment
$ env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps --locked
     Documenting member v0.1.0 (outer/repo/member)
    error: unresolved link to `nope`
    -> exit 101
# C1b the same file, no variable in the environment (the gate is then expected in the file itself)
$ cargo doc --workspace --no-deps --locked
     Documenting member v0.1.0 (outer/repo/member)
    error: unresolved link to `nope`
    -> exit 101
# C1c [build] rustdocflags = ["-Dwarnings"] in repo/.cargo/config.toml and [build] rustdocflags = ["--cap-lints","allow"] in member/.cargo/config.toml, cwd = member
$ (cd member && cargo doc --no-deps --locked)
    -> exit 0
# C2 member/Cargo.toml [lints.rustdoc] broken_intra_doc_links = "allow"
$ env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps --locked
       Generated $S/target/doc/doc/member/index.html
     Documenting member v0.1.0 (outer/repo/member)
    -> exit 0
# C3 member/Cargo.toml [lib] doc = false
$ env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps --locked
    -> exit 0
# C4 member/Cargo.toml [package.metadata.docs.rs] rustdoc-args
$ env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps --locked
     Documenting member v0.1.0 (outer/repo/member)
    error: unresolved link to `nope`
    -> exit 101
# C5 source: #![allow(rustdoc::broken_intra_doc_links)]
$ env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps --locked
       Generated $S/target/doc/doc/member/index.html
     Documenting member v0.1.0 (outer/repo/member)
    -> exit 0
# C6 repo/.cargo/config.toml [build] rustdoc = "/usr/bin/true"
$ env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps --locked
     Documenting member v0.1.0 (outer/repo/member)
    -> exit 0
# C6b the same with RUSTDOC=rustdoc in the environment
$ env RUSTDOC=rustdoc env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps --locked
     Documenting member v0.1.0 (outer/repo/member)
    error: unresolved link to `nope`
    -> exit 101
# C7 repo/.cargo/config.toml [env] RUSTDOCFLAGS forced (does cargo itself take its flags from [env]?)
$ env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps --locked
     Documenting member v0.1.0 (outer/repo/member)
    error: unresolved link to `nope`
    -> exit 101
# C8 repo/.cargo/config.toml [alias] doc = "help" (doc is built in)
$ env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps --locked
     Documenting member v0.1.0 (outer/repo/member)
    error: unresolved link to `nope`
    warning: user-defined alias `doc` is ignored, because it is shadowed by a built-in command
    -> exit 101

