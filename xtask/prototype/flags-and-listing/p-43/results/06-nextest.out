## D. explicit arguments with repo/.config/nextest.toml (the canary) present
# D1 --config-file <file outside the tree>
$ (cd outer/repo && cargo nextest run --workspace --locked --config-file trusted/nextest.toml)
         Summary [   0.007s] 2 tests run: 1 passed, 1 failed, 0 skipped
      Cancelling due to test failure
    error: test run failed
    -> exit 100
# D2 --ignore-default-filter
$ (cd outer/repo && cargo nextest run --workspace --locked --ignore-default-filter)
         Summary [   0.007s] 2 tests run: 1 passed, 1 failed, 0 skipped
      Cancelling due to test failure
    error: test run failed
    -> exit 100
# D3 --tool-config-file t:<trusted file> (tool config sits below the repository config)
$ (cd outer/repo && cargo nextest run --workspace --locked --tool-config-file t:trusted/nextest.toml)
         Summary [   0.007s] 1 test run: 1 passed, 1 skipped
    -> exit 0
# D4 NEXTEST_CONFIG_FILE=<trusted> (is there such a variable?)
$ (cd outer/repo && env NEXTEST_CONFIG_FILE=trusted/nextest.toml cargo nextest run --workspace --locked)
         Summary [   0.007s] 1 test run: 1 passed, 1 skipped
    -> exit 0
# D5 -E 'all()' on the command line
$ (cd outer/repo && cargo nextest run --workspace --locked -E all())
         Summary [   0.007s] 1 test run: 1 passed, 1 skipped
    -> exit 0
# D6 --profile ci where repo/.config/nextest.toml defines [profile.ci] default-filter
$ (cd outer/repo && cargo nextest run --workspace --locked --profile ci)
         Summary [   0.007s] 1 test run: 1 passed, 1 skipped
    -> exit 0

## E. other keys of the repository config
# E1 per-test override (retries; shows the file steers single tests)
$ (cd outer/repo && cargo nextest run --workspace --locked)
         Summary [   0.023s] 2 tests run: 1 passed, 1 failed, 0 skipped
      Cancelling due to test failure
    error: test run failed
    -> exit 100
# E2 a setup script declared and switched on by the file itself
$ (cd outer/repo && cargo nextest run --workspace --locked)
           SETUP [      1/1] s: /bin/sh -c 'echo SETUP-SCRIPT-RAN >&2'
         Summary [   0.015s] 2 tests run: 1 passed, 1 failed, 0 skipped
      Cancelling due to test failure
      SETUP PASS [   0.008s] s: /bin/sh -c 'echo SETUP-SCRIPT-RAN >&2'
    error: test run failed
    info: experimental features enabled: setup-scripts
    SETUP-SCRIPT-RAN
    -> exit 100
# E3 a wrapper script /usr/bin/true around every test
$ (cd outer/repo && cargo nextest run --workspace --locked)
         Summary [   0.006s] 2 tests run: 2 passed, 0 skipped
    info: experimental features enabled: wrapper-scripts
    -> exit 0
# E4 nextest-version required = 99.0.0
$ (cd outer/repo && cargo nextest run --workspace --locked)
    error: this repository requires nextest version 99.0.0, but the current version is 0.9.152
    info: update nextest with cargo nextest self update, or bypass check with --override-version-check
    -> exit 92
# E5 an unknown key in the file
$ (cd outer/repo && cargo nextest run --workspace --locked)
         Summary [   0.007s] 1 test run: 1 passed, 1 skipped
    warning: in config file .config/nextest.toml, ignoring unknown configuration key: profile.default.no_such_key
    -> exit 0

