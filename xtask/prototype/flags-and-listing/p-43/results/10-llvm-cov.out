## C. inputs that do change the verdict
# C1 source: #[cfg(not(coverage))] on the uncovered function
$ cargo llvm-cov --workspace --locked --fail-under-lines 100
    TOTAL: lines 6, missed 0, cover 100.00%
    -> exit 0
# C2 the uncovered function lives in member/src/benches/mod.rs
$ cargo llvm-cov --workspace --locked --fail-under-lines 100
    TOTAL: lines 6, missed 0, cover 100.00%
    -> exit 0
# C2 the uncovered function lives in member/src/tests/mod.rs
$ cargo llvm-cov --workspace --locked --fail-under-lines 100
    TOTAL: lines 6, missed 0, cover 100.00%
    -> exit 0
# C2 the uncovered function lives in member/src/examples/mod.rs
$ cargo llvm-cov --workspace --locked --fail-under-lines 100
    TOTAL: lines 6, missed 0, cover 100.00%
    -> exit 0
# C2 the uncovered function lives in member/src/extra/mod.rs
$ cargo llvm-cov --workspace --locked --fail-under-lines 100
    TOTAL: lines 9, missed 3, cover 66.67%
    -> exit 1
# C3 repo/.cargo/config.toml [build] rustflags = ["--cfg","skipcov"] and the function under #[cfg(not(skipcov))] (do config rustflags reach the instrumented build?)
$ cargo llvm-cov --workspace --locked --fail-under-lines 100
    TOTAL: lines 6, missed 0, cover 100.00%
    -> exit 0
# C4 repo/.cargo/config.toml [env] with cargo-llvm-cov's own variables
$ cargo llvm-cov --workspace --locked --fail-under-lines 100
    TOTAL: lines 9, missed 3, cover 66.67%
    -> exit 1
# C4 control: the variable in the real environment
$ env CARGO_LLVM_COV_FLAGS=--ignore-filename-regex=lib LLVM_COV_FLAGS=--ignore-filename-regex=lib cargo llvm-cov --workspace --locked --fail-under-lines 100
    TOTAL: lines 0, missed 0, cover -
    -> exit 1
# C5 repo/.cargo/config.toml [alias] llvm-cov = "help"
$ cargo llvm-cov --workspace --locked --fail-under-lines 100
    warning: user-defined alias `llvm-cov` is shadowing an external subcommand found at `$S/tools/bin/cargo-llvm-cov`
    error: unexpected argument '--workspace' found
    -> exit 1
# C6 repo/.cargo/config.toml runner = /usr/bin/true (no test runs, so no profile data)
$ cargo llvm-cov --workspace --locked --fail-under-lines 100
    error: failed to merge profile data: not found *.profraw files in $S/target/llvmcov/llvm-cov-target; this may occur if target directory is accidentally cleared, or running report subcommand without running any tests or binaries
    -> exit 1

