## C. cwd = member directory
# member, root, outer and CARGO_HOME files all present
$ (cd outer/repo/member &&  cargo metadata | target_directory ; cargo --list | grep canary)
    target_directory = outer/repo/member/td-member
    alias: canary-home          alias: version
    alias: canary-member        alias: version
    alias: canary-outer         alias: version
    alias: canary-root          alias: version
# same files, cwd = workspace root
$ (cd outer/repo &&  cargo metadata | target_directory ; cargo --list | grep canary)
    target_directory = outer/repo/td-root
    alias: canary-home          alias: version
    alias: canary-outer         alias: version
    alias: canary-root          alias: version
# same files, cwd outside the tree, --manifest-path into it
    target_directory = $HOME/td-home

## D. config and config.toml in the same directory
$ (cd outer/repo &&  cargo metadata | target_directory ; cargo --list | grep canary)
    stderr: warning: both `outer/repo/.cargo/config` and `outer/repo/.cargo/config.toml` exist. Using `outer/repo/.cargo/config`
    target_directory = outer/repo/td-legacy
    alias: canary-legacy        alias: version
