## G. cargo test: inputs that change the verdict of a failing test
# G0: control
$ cargo test --workspace --locked
        Finished `test` profile [unoptimized + debuginfo] target(s) in 0.38s
    error: test failed, to rerun pass `--lib`
  -> exit 101
# G1: repo/.cargo/config.toml [target.aarch64-apple-darwin] runner = "/usr/bin/true"
$ cargo test --workspace --locked
        Finished `test` profile [unoptimized + debuginfo] target(s) in 0.09s
  -> exit 0
# G2: same, CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER= (empty) in the environment
$ CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER= cargo test --workspace --locked
    error: error in environment variable `CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER`: could not load config key `target.aarch64-apple-darwin.runner`
  -> exit 101
# G3: [target."cfg(all())"] runner in the file, CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER=/usr/bin/env in the environment
$ CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER=/usr/bin/env cargo test --workspace --locked
        Finished `test` profile [unoptimized + debuginfo] target(s) in 0.09s
    error: test failed, to rerun pass `--lib`
  -> exit 101
# G4: member/Cargo.toml [lib] test = false
$ cargo test --workspace --locked
        Finished `test` profile [unoptimized + debuginfo] target(s) in 0.00s
  -> exit 0
# G5: member/build.rs added (no Cargo.toml change) emits a cfg that compiles the failing test out
$ cargo test --workspace --locked
        Finished `test` profile [unoptimized + debuginfo] target(s) in 0.32s
  -> exit 0

