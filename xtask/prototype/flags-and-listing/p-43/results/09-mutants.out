## C. other working directories (repo/.cargo/mutants.toml is the canary)
# cwd = member
$ (cd outer/repo/member && cargo mutants --list)
    -> exit 0; mutants listed: 0
# cwd outside, --dir repo
$ (cd $S && cargo mutants --dir outer/repo --list)
    -> exit 0; mutants listed: 0
# cwd outside, --manifest-path
$ (cd $S && cargo mutants --manifest-path outer/repo/Cargo.toml --list)
    -> exit 0; mutants listed: 0
# only member/.cargo/mutants.toml, cwd = member
$ (cd outer/repo/member && cargo mutants --list)
    -> exit 0; mutants listed: 4

## D. explicit arguments with repo/.cargo/mutants.toml (canary) present
# D1 --no-config
$ (cd outer/repo && cargo mutants --no-config --list)
    -> exit 0; mutants listed: 4
# D2 --config <file outside the tree>
$ (cd outer/repo && cargo mutants --config trusted/mutants.toml --list)
    -> exit 0; mutants listed: 4
# D3 --config <file that does not exist>
$ (cd outer/repo && cargo mutants --config trusted/nope.toml --list)
    -> exit 1; mutants listed: 0 ; Error: read config trusted/nope.toml
# D4 -f '**/*.rs' on the command line (does an explicit --file beat exclude_globs of the file?)
$ (cd outer/repo && cargo mutants -f **/*.rs --list)
    -> exit 0; mutants listed: 0

## E. other inputs
# E1 [package.metadata.*] / [workspace.metadata.*] tables in Cargo.toml
$ (cd outer/repo && cargo mutants --list)
    -> exit 0; mutants listed: 4
# E2 #[mutants::skip] on the function (no dependency on the mutants crate declared)
$ (cd outer/repo && cargo mutants --list)
    -> exit 0; mutants listed: 0
# E3 a real run, no test covers f: baseline verdict
$ (cd outer/repo && cargo mutants )
    -> exit 2; mutants listed: 4 ; 4 mutants tested in 1s: 4 missed
# E3b a config that only changes how tests are run (additional_cargo_test_args)
$ (cd outer/repo && cargo mutants )
    -> exit 2; mutants listed: 4 ; 4 mutants tested in 1s: 4 missed
# E3c a real run with exclude_re = [".*"]
$ (cd outer/repo && cargo mutants )
    -> exit 0; mutants listed: 0
# E4 .gitignore lists member/src/lib.rs (--list, then a real run)
$ (cd outer/repo && cargo mutants --list)
    -> exit 0; mutants listed: 4
$ (cd outer/repo && cargo mutants )
    -> exit 2; mutants listed: 4 ; 4 mutants tested in 1s: 4 missed
# E5 .ignore lists member/src/lib.rs
$ (cd outer/repo && cargo mutants --list)
