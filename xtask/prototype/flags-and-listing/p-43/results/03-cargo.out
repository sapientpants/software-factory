## E. explicit settings against an in-tree file (repo/.cargo/config.toml sets target-dir=td-root)
# E1: CARGO_BUILD_TARGET_DIR / CARGO_TARGET_DIR in the environment
$ (cd outer/repo && CARGO_TARGET_DIR=/tmp/td-env cargo metadata | target_directory ; cargo --list | grep canary)
    target_directory = /tmp/td-env
    alias: canary-root          alias: version
# E2: --config on the command line
    target_directory = outer/repo/td-cli
# E3: the in-tree alias is still defined with the variable set (the file is still read):
    canary-root          alias: version
# E4: include = [...] inside .cargo/config.toml pulling an unprotected path
$ (cd outer/repo &&  cargo metadata | target_directory ; cargo --list | grep canary)
    target_directory = outer/td-included
    alias: canary-included      alias: version

## F. rustflags: environment against file (clippy canary: clippy.toml disallows std::env::var, the source calls it)
# F1: [build] rustflags = ["--cap-lints","allow"] in repo/.cargo/config.toml, no variable
$ cargo clippy --workspace --all-targets --locked -- -D warnings
        Finished `dev` profile [unoptimized + debuginfo] target(s) in 0.14s
  -> exit 0
# F2: plus RUSTFLAGS=--cfg=x in the environment
$ RUSTFLAGS=--cfg=x cargo clippy --workspace --all-targets --locked -- -D warnings
      = note: CANARY
    error: could not compile `member` (lib test) due to 1 previous error
    error: could not compile `member` (lib) due to 1 previous error
    error: use of a disallowed method `std::env::var`
  -> exit 101
# F3: plus RUSTFLAGS= (set, empty)
$ RUSTFLAGS= cargo clippy --workspace --all-targets --locked -- -D warnings
      = note: CANARY
    error: could not compile `member` (lib test) due to 1 previous error
    error: could not compile `member` (lib) due to 1 previous error
    error: use of a disallowed method `std::env::var`
  -> exit 101
# F4: plus CARGO_ENCODED_RUSTFLAGS= (set, empty)
$ CARGO_ENCODED_RUSTFLAGS= cargo clippy --workspace --all-targets --locked -- -D warnings
      = note: CANARY
    error: could not compile `member` (lib test) due to 1 previous error
    error: could not compile `member` (lib) due to 1 previous error
    error: use of a disallowed method `std::env::var`
  -> exit 101
# F5: plus CARGO_BUILD_RUSTFLAGS=--cfg=x
$ CARGO_BUILD_RUSTFLAGS=--cfg=x cargo clippy --workspace --all-targets --locked -- -D warnings
        Finished `dev` profile [unoptimized + debuginfo] target(s) in 0.05s
  -> exit 0
# F6: [target.aarch64-apple-darwin] rustflags in the file, RUSTFLAGS=--cfg=x in the environment
$ RUSTFLAGS=--cfg=x cargo clippy --workspace --all-targets --locked -- -D warnings
      = note: CANARY
    error: could not compile `member` (lib test) due to 1 previous error
    error: could not compile `member` (lib) due to 1 previous error
    error: use of a disallowed method `std::env::var`
  -> exit 101
# F7: same file, CARGO_BUILD_RUSTFLAGS=--cfg=x
$ CARGO_BUILD_RUSTFLAGS=--cfg=x cargo clippy --workspace --all-targets --locked -- -D warnings
        Finished `dev` profile [unoptimized + debuginfo] target(s) in 0.03s
  -> exit 0
# F8: same file, --config 'build.rustflags=[]' on the command line
$ cargo clippy --config build.rustflags=[] --workspace --all-targets --locked -- -D warnings
        Finished `dev` profile [unoptimized + debuginfo] target(s) in 0.03s
