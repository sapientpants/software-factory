{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "event=$(cat); case $event in *git*) cd \"$CLAUDE_PROJECT_DIR\" && printf '%s' \"$event\" | cargo --quiet xtask pre-tool-use || exit 2 ;; esac"
          }
        ]
      }
    ]
  }
}
